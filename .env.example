# ── Canonical site URL ────────────────────────────────────────────────
# Set this to your real domain once it is connected. Sitemap, robots.txt,
# canonical links and hreflang tags are all derived from it.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── AI assistant (AAA) ────────────────────────────────────────────────
# Free key: https://aistudio.google.com/app/apikey
# Without it the chat still renders and explains that it is not connected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Contact form (optional) ───────────────────────────────────────────
# Without these the form falls back to opening the visitor's mail client.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
